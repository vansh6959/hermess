# Hermes connects to your own Spotify Developer app.
# Copy this file to .env.local and fill values there.
# Next.js does NOT load .env.example at runtime.

# --- Spotify Web API (server-side search) ---------------------------
# Create an app at https://developer.spotify.com/dashboard.
# Keep these server-only. Never prefix them with NEXT_PUBLIC_.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional ISO 3166-1 alpha-2 market used to filter search results.
SPOTIFY_MARKET=

# Required for user login/playback OAuth. Search uses Client Credentials.
# Spotify rejects http://localhost: use http://127.0.0.1 (or an HTTPS URL)
# and register this exact value in the Spotify dashboard.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback

# --- Future authentication -----------------------------------------
AUTH_SECRET=
